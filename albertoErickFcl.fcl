FUNCTION_BLOCK firePower	// Block definition

// Define input variables
VAR_INPUT				
	ourEnergy : REAL;
	distance : REAL;
	prediction: REAL;
	enemySpeed: REAL;
END_VAR

// Define output variable
VAR_OUTPUT				
	firePower : REAL;
END_VAR

// Fuzzify input variable 'distance': {'near', 'relative' , 'far'}
FUZZIFY distance			
	TERM near := (0, 1) (100, 1) (250, 0); 
	TERM relative := (100, 0) (250, 1) (400, 0);
	TERM far := (250, 0) (400, 1) (1000, 1);
END_FUZZIFY

// Fuzzify input variable 'enemySpeed': {'slow', 'medium' , 'fast'}
FUZZIFY enemySpeed			
	TERM slow := (0, 1) (2, 1) (3, 0) ; 
	TERM medium := (2, 0) (3, 1) (5, 1) (6, 0);
	TERM fast := (5, 0) (6, 1) (8, 1);
END_FUZZIFY

// Fuzzify input variable 'ourEnergy': {'low', 'medium' , 'high'}
FUZZIFY ourEnergy			
	TERM low := (0, 1) (16, 1) (33, 0) ; 
	TERM medium := (16, 0) (33, 1) (66, 1) (82, 0);
	TERM high := (66, 0) (82, 1) (100, 1);
END_FUZZIFY

// Fuzzify input variable 'prediction': {'low', 'medium' , 'high'}
FUZZIFY prediction			
	TERM low := (0, 1) (0.39, 1) (0.78, 0) ; 
	TERM medium := (0.39, 0) (0.78, 1) (2.0, 1) (3.14, 0) ;
	TERM high := (2.0, 0) (3.14, 1) (6.26, 1);
END_FUZZIFY

// Defuzzify output variable 'firePower' : {'weak', 'medium', 'strong' }
DEFUZZIFY firePower			
	TERM weak := (0, 1) (1,1) (1.5, 0);
	TERM medium := (1, 0)  (1.5,1) (2, 0);
	TERM strong := (1.5,0) (2,1) (3,1);
	METHOD : COG;		// Use 'Center Of Gravity' defuzzification method
	DEFAULT := 0.1;		// Default value is 0.1 (if no rule activates defuzzifier)
END_DEFUZZIFY

// Inference rules
RULEBLOCK No1
	AND : MIN;	// Use 'min' for 'and'
	ACT : MIN;	// Use 'min' activation method
	ACCU : MAX;	// Use 'max' accumulation method

	RULE 1 : IF distance IS near AND enemySpeed IS slow AND ourEnergy IS high AND prediction IS low THEN firePower IS strong;
	RULE 2 : IF distance IS near AND enemySpeed IS slow AND ourEnergy IS medium AND prediction IS low THEN firePower IS strong;
	RULE 3 : IF distance IS near AND enemySpeed IS slow AND ourEnergy IS low AND prediction IS low THEN firePower IS medium;
	RULE 4 : IF distance IS near AND enemySpeed IS medium AND ourEnergy IS high AND prediction IS low THEN firePower IS strong;
	RULE 5 : IF distance IS near AND enemySpeed IS fast AND ourEnergy IS high AND prediction IS low THEN firePower IS weak;
	RULE 6 : IF distance IS near AND enemySpeed IS fast AND ourEnergy IS medium AND prediction IS low THEN firePower IS medium;
	RULE 7 : IF distance IS near AND enemySpeed IS fast AND ourEnergy IS low AND prediction IS low THEN firePower IS medium;
	RULE 8 : IF distance IS relative AND enemySpeed IS slow AND ourEnergy IS high AND prediction IS low THEN firePower IS medium;
	RULE 8 : IF distance IS relative AND enemySpeed IS medium AND ourEnergy IS high AND prediction IS low THEN firePower IS weak;
	RULE 9 : IF distance IS relative AND enemySpeed IS fast AND ourEnergy IS high AND prediction IS low THEN firePower IS weak;

END_RULEBLOCK

END_FUNCTION_BLOCK

FUNCTION_BLOCK prediction

VAR_INPUT
	distance : REAL;
	aimCorrection: REAL;
	enemySpeed: REAL;
END_VAR

VAR_OUTPUT				
	prediction : REAL;
END_VAR

FUZZIFY distance			
	TERM near := (0, 1) (100, 1) (250, 0); 
	TERM relative := (100, 0) (250, 1) (400, 0);
	TERM far := (250, 0) (400, 1) (1000, 1);
END_FUZZIFY

FUZZIFY enemySpeed			
	TERM slow := (0, 1) (2, 1) (3, 0) ; 
	TERM medium := (2, 0) (3, 1) (5, 1) (6, 0);
	TERM fast := (5, 0) (6, 1) (8, 1);
END_FUZZIFY

FUZZIFY aimCorrection
	TERM low := (0, 1) (0.39, 1) (0.78, 0) ; 
	TERM medium := (0.39, 0) (0.78, 1) (2.0, 1) (3.14, 0) ;
	TERM high := (2.0, 0) (3.14, 1) (6.26, 1);
END_FUZZIFY

DEFUZZIFY prediction			
	TERM short := (0, 1) (0.10,1) (0.15, 0);
	TERM medium := (0.10, 0)  (0.15,1) (0.25, 1) (0.35, 0);
	TERM long := (0.25,0) (0.35,1) (0.5,1);
	METHOD : COG;		// Use 'Center Of Gravity' defuzzification method
	DEFAULT := 0.0;		// Default value is 0 (if no rule activates defuzzifier)
END_DEFUZZIFY

RULEBLOCK No2
	AND : MIN;	// Use 'min' for 'and'
	ACT : MIN;	// Use 'min' activation method
	ACCU : MAX;	// Use 'max' accumulation method

	RULE 1 : IF distance IS near AND enemySpeed IS slow AND aimCorrection IS low THEN prediction IS short;
	RULE 2 : IF distance IS near AND enemySpeed IS medium AND aimCorrection IS low THEN prediction IS medium;
	RULE 3 : IF distance IS near AND enemySpeed IS fast AND aimCorrection IS low THEN prediction IS long;
	RULE 4 : IF distance IS relative AND enemySpeed IS slow AND aimCorrection IS low THEN prediction IS short;
	RULE 5 : IF distance IS relative AND enemySpeed IS medium AND aimCorrection IS low THEN prediction IS medium;
	RULE 6 : IF distance IS relative AND enemySpeed IS fast AND aimCorrection IS low THEN prediction IS medium;
	RULE 7 : IF distance IS relative AND enemySpeed IS medium AND aimCorrection IS medium THEN prediction IS medium;
	RULE 8 : IF distance IS relative AND enemySpeed IS medium AND aimCorrection IS high THEN prediction IS long;
	RULE 9 : IF distance IS far AND enemySpeed IS slow AND aimCorrection IS low THEN prediction IS short;
	RULE 9 : IF distance IS far AND enemySpeed IS slow AND aimCorrection IS medium THEN prediction IS short;
	RULE 10 : IF distance IS far AND enemySpeed IS medium AND aimCorrection IS low THEN prediction IS medium;
	RULE 11 : IF distance IS far AND enemySpeed IS fast AND aimCorrection IS low THEN prediction IS medium;
	RULE 12 : IF distance IS far AND enemySpeed IS fast AND aimCorrection IS medium THEN prediction IS medium;
	RULE 13 : IF distance IS far AND enemySpeed IS fast AND aimCorrection IS high THEN prediction IS long;

END_RULEBLOCK

END_FUNCTION_BLOCK